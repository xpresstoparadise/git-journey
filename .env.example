# Copy to .env (never commit .env). fetch_gitlab.py reads it; prototype/.env is still honoured.
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# 2026 or a range: 2025-2026
GITLAB_PERIOD=2026
# Used when a project has no default_branch
GITLAB_DEFAULT_BRANCH=main
# Optional: how many commits / MRs per repo to draw (totals are always exact)
# LIFEWAY_MAX_COMMITS=80
# LIFEWAY_MAX_MRS=40
